# Copy to app/.env and fill in from Supabase dashboard -> Project Settings -> API Keys.
# These are public client keys (they ship in the browser bundle); never put the
# service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Set ONE of these. If the publishable key is non-empty it is used; otherwise the anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=your-anon-key
